---
import { type Language, DEFAULT_LANGUAGE } from '../../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  docType?: string;
  path?: string;
  lang?: Language;
}

const {
  title = 'Documento',
  description = 'Documento del cliente',
  docType = 'MD',
  path = '#',
  lang = DEFAULT_LANGUAGE,
} = Astro.props;
---

<a href={path} class="block group">
  <article class="doc-card">
    <div class="doc-card__top">
      <p class="doc-card__tag">{docType}</p>
      <span class="doc-card__arrow">→</span>
    </div>
    <h3 class="mt-4 text-[1.08rem] md:text-[1.18rem] font-semibold text-indigo-100 leading-tight">{title}</h3>
    <p class="mt-3 text-[0.94rem] leading-relaxed text-gray-300">{description}</p>
    <div class="mt-5 text-sm font-medium text-indigo-300">{lang === 'es' ? 'Abrir documento' : 'Open document'}</div>
  </article>
</a>

<style>
  .doc-card {
    height: 100%;
    border-radius: 1.25rem;
    padding: 1.2rem 1.2rem 1.25rem;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.75), rgba(8, 10, 20, 0.96));
    border: 1px solid rgba(129, 140, 248, 0.14);
    box-shadow: 0 16px 40px rgba(2, 6, 23, 0.34);
    transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease;
  }

  .group:hover .doc-card {
    transform: translateY(-4px);
    border-color: rgba(129, 140, 248, 0.28);
    box-shadow: 0 20px 52px rgba(2, 6, 23, 0.48);
  }

  .doc-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .doc-card__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    background: rgba(79, 70, 229, 0.16);
    color: #c7d2fe;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .doc-card__arrow {
    color: #a5b4fc;
    font-size: 1.35rem;
    transition: transform 260ms ease;
  }

  .group:hover .doc-card__arrow {
    transform: translateX(2px);
  }
</style>
