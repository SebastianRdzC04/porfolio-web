---
import { type Language, DEFAULT_LANGUAGE } from '../../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  imageUrl?: string;
  path?: string;
  status?: string;
  industry?: string;
  lang?: Language;
}

const {
  title = 'ProSerLag',
  description = 'Oficina de abogados con documentación y seguimiento del sistema en curso.',
  imageUrl = '/projects/elroble.png',
  path = '#',
  status = 'Cliente actual',
  industry = 'Servicios legales',
  lang = DEFAULT_LANGUAGE,
} = Astro.props;

const imageSource = imageUrl.startsWith('http') || imageUrl.startsWith('/')
  ? imageUrl
  : `/projects/${imageUrl.replace(/^\.\/?/, '')}`;
---

<a href={path} class="block group">
  <section class="client-card w-[320px] md:w-[350px] flex-shrink-0">
    <div class="client-card__image-wrap">
      <img src={imageSource} alt={title} class="client-card__image" />
      <div class="client-card__overlay"></div>
      <div class="client-card__badge">{status}</div>
    </div>

    <div class="px-5 py-5">
      <p class="text-[0.78rem] uppercase tracking-[0.28em] text-indigo-300/80 mb-2">{industry}</p>
      <h2 class="text-[1.22rem] md:text-[1.32rem] leading-tight font-bold text-indigo-100">{title}</h2>
      <p class="mt-3 text-[0.95rem] leading-relaxed text-gray-300">{description}</p>
      <div class="mt-5 flex items-center justify-between text-sm text-gray-400">
        <span>{lang === 'es' ? 'Expediente vivo' : 'Live dossier'}</span>
        <span class="client-card__cta">{lang === 'es' ? 'Abrir' : 'Open'}</span>
      </div>
    </div>
  </section>
</a>

<style>
  .client-card {
    border-radius: 1.5rem;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.78), rgba(8, 10, 20, 0.96));
    border: 1px solid rgba(129, 140, 248, 0.14);
    box-shadow: 0 18px 50px rgba(2, 6, 23, 0.42);
    transition: transform 280ms ease, border-color 280ms ease, box-shadow 280ms ease;
  }

  .group:hover .client-card {
    transform: translateY(-4px);
    border-color: rgba(129, 140, 248, 0.28);
    box-shadow: 0 22px 70px rgba(2, 6, 23, 0.58);
  }

  .client-card__image-wrap {
    position: relative;
    height: 190px;
    overflow: hidden;
  }

  .client-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .group:hover .client-card__image {
    transform: scale(1.05);
  }

  .client-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.06), rgba(15, 23, 42, 0.78));
  }

  .client-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(129, 140, 248, 0.2);
    color: #c7d2fe;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .client-card__cta {
    color: #c7d2fe;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
