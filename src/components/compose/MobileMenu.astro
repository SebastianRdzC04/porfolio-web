---
import { type Language, DEFAULT_LANGUAGE } from '../../utils/i18n';
import { useTranslations, type TranslationKey } from '../../utils/translations';

interface Props {
  lang?: Language;
}

const { lang = DEFAULT_LANGUAGE } = Astro.props;
const t = useTranslations(lang);

// Función para generar URLs según el idioma
function getLocalizedUrl(path: string, language: Language): string {
  if (language === DEFAULT_LANGUAGE) {
    return path;
  }
  return `/en${path}`;
}

interface NavItem {
  titleKey: TranslationKey;
  url: string;
}

const navItems: NavItem[] = [
    { 
      titleKey: "nav.home",
      url: getLocalizedUrl("/", lang)
    },
    { 
      titleKey: "nav.about",
      url: getLocalizedUrl("/#about-me", lang)
    },
    { 
      titleKey: "nav.projects",
      url: getLocalizedUrl("/#projects", lang)
    },
    { 
      titleKey: "nav.contact",
      url: getLocalizedUrl("/#contact", lang)
    }
];

// Etiquetas de accesibilidad según el idioma
const menuLabel = lang === 'es' ? 'Menú' : 'Menu';
const closeMenuLabel = lang === 'es' ? 'Cerrar menú' : 'Close menu';
---

<div class="mobile-menu-container block md:hidden">
    <!-- Hamburger Button -->
    <button id="mobile-menu-button" class="hamburger-btn flex flex-col justify-center items-center w-8 h-8" aria-label={menuLabel}>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>

    <!-- Mobile Sidebar -->
    <div id="mobile-sidebar" class="fixed top-0 right-0 w-64 h-screen bg-black/89 transform translate-x-full transition-transform duration-300 ease-in-out z-50 backdrop-blur-lg" role="dialog" aria-modal="true">
        <div class="flex flex-col p-5 h-full">
            <!-- Close button -->
            <button id="close-sidebar-button" class="hamburger-btn flex flex-col justify-center items-center w-8 h-8 ml-auto" aria-label={closeMenuLabel}>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
            
            <!-- Navigation Links -->
                <nav class="flex flex-col space-y-4" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
                    {navItems.map((item) => (
                    <a href={item.url} class="text-white text-[1.125rem] py-2 hover:text-emerald-400 transition-colors duration-300">
                        {t(item.titleKey)}
                    </a>
                ))}
            </nav>
        </div>
    </div>
    
    <!-- Overlay to close sidebar when clicked outside -->
    <div id="overlay" class="fixed inset-0 bg-black opacity-0 pointer-events-none transition-opacity duration-300 z-40"></div>
</div>

<style>
    .hamburger-line {
        width: 1.5rem; /* w-6 */
        height: 2px;    /* h-0.5 */
        background-color: white;
        margin: 0.25rem 0; /* my-1 */
        transition: all 300ms;
        display: block;
        transform-origin: center;
    }

    /* Cuando el botón tenga .menu-open */
    .menu-open .hamburger-line:nth-child(1) {
        transform: rotate(45deg) translateY(6px);
    }
    .menu-open .hamburger-line:nth-child(2) {
        opacity: 0;
    }
    .menu-open .hamburger-line:nth-child(3) {
        transform: rotate(-45deg) translateY(-6px);
    }
</style>

<script is:inline>
    // Reinicializar el menú móvil
    function initMobileMenu() {
        const menuButton = document.getElementById('mobile-menu-button');
        const sidebar = document.getElementById('mobile-sidebar');
        const closeButton = document.getElementById('close-sidebar-button');
        const overlay = document.getElementById('overlay');
        
        if (!menuButton || !sidebar || !closeButton || !overlay) {
            return;
        }
        
        let isMenuOpen = false;
        
        function openMenu() {
            if (!sidebar || !menuButton || !closeButton || !overlay) return;
            sidebar.classList.remove('translate-x-full');
            menuButton.classList.add('menu-open');
            closeButton.classList.add('menu-open');
            overlay.classList.add('opacity-50');
            overlay.classList.remove('pointer-events-none');
            document.body.style.overflow = 'hidden';
            isMenuOpen = true;
        }
        
        function closeMenu() {
            if (!sidebar || !menuButton || !closeButton || !overlay) return;
            sidebar.classList.add('translate-x-full');
            menuButton.classList.remove('menu-open');
            closeButton.classList.remove('menu-open');
            overlay.classList.remove('opacity-50');
            overlay.classList.add('pointer-events-none');
            document.body.style.overflow = '';
            isMenuOpen = false;
        }
        
        // Limpiar listeners previos clonando elementos
        const newMenuButton = menuButton.cloneNode(true);
        const newCloseButton = closeButton.cloneNode(true);
        const newOverlay = overlay.cloneNode(true);
        
        if (menuButton.parentNode) menuButton.parentNode.replaceChild(newMenuButton, menuButton);
        if (closeButton.parentNode) closeButton.parentNode.replaceChild(newCloseButton, closeButton);
        if (overlay.parentNode) overlay.parentNode.replaceChild(newOverlay, overlay);
        
        const updatedMenuButton = document.getElementById('mobile-menu-button');
        const updatedCloseButton = document.getElementById('close-sidebar-button');
        const updatedOverlay = document.getElementById('overlay');
        
        // Añadir event listeners
        if (updatedMenuButton) {
            updatedMenuButton.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (isMenuOpen) closeMenu(); else openMenu();
            });
        }
        
        if (updatedCloseButton) {
            updatedCloseButton.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeMenu();
            });
        }
        
        if (updatedOverlay) {
            updatedOverlay.addEventListener('click', function() {
                closeMenu();
            });
        }
        
        // Cerrar al hacer clic en un enlace de navegación
        const navLinks = document.querySelectorAll('#mobile-sidebar nav a');
        navLinks.forEach(function(link) {
            const newLink = link.cloneNode(true);
            if (link.parentNode) link.parentNode.replaceChild(newLink, link);
        });
        
        const updatedNavLinks = document.querySelectorAll('#mobile-sidebar nav a');
        updatedNavLinks.forEach(function(link) {
            link.addEventListener('click', closeMenu);
        });
        
        // Cerrar con ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && isMenuOpen) {
                closeMenu();
            }
        });
    }

    // Inicializar en carga de página con View Transitions
    initMobileMenu();
    document.addEventListener('astro:page-load', initMobileMenu);
</script>
