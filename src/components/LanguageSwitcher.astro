---
import { LANGUAGES, type Language } from '../utils/i18n';
import { useTranslations } from '../utils/translations';

interface Props {
  currentLang: Language;
  currentPath: string;
  translations?: Record<Language, { data: { path?: string } } | undefined>;
  contentBasePath?: string;
}

const { currentLang, currentPath, translations, contentBasePath = '/projects' } = Astro.props;
const t = useTranslations(currentLang);

// Determinar la etiqueta de accesibilidad según el idioma actual
const ariaLabel = currentLang === 'es' ? 'Cambiar idioma' : 'Change language';
---

<div class="language-switcher">
  <div class="language-dropdown" id="language-dropdown">
    <button 
      class="language-icon" 
      aria-label={ariaLabel}
      aria-expanded="false"
      aria-haspopup="true"
      id="language-toggle"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
    </button>
    <div class="language-menu" id="language-menu" role="menu">
      {Object.entries(LANGUAGES).map(([code, name]) => {
        const lang = code as Language;
        const isActive = lang === currentLang;
        
        let href: string;
        if (translations && translations[lang]) {
          const projectPath = translations[lang]?.data?.path;
          href = lang === 'es' ? `${contentBasePath}/${projectPath}` : `/en${contentBasePath}/${projectPath}`;
        } else {
          // Para páginas generales
          if (currentPath === '/' || currentPath === '/en/') {
            href = lang === 'es' ? '/' : '/en/';
          } else {
            // Remover el prefijo de idioma si existe
            const pathWithoutLang = currentPath.replace(/^\/en\//, '/');
            href = lang === 'es' ? pathWithoutLang : `/en${pathWithoutLang}`;
          }
        }
        
        return (
          <a
            href={href}
            class={`language-option ${isActive ? 'active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
            data-lang={lang}
            role="menuitem"
            hreflang={lang}
          >
            {name}
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .language-switcher {
    position: fixed;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 50;
  }
  
  .language-dropdown {
    position: relative;
  }
  
  .language-icon {
    background-color: rgba(30, 41, 59, 0.8);
    border: none;
    color: white;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  
  .language-icon:hover {
    background-color: rgba(37, 99, 235, 0.9);
    transform: scale(1.05);
  }
  
  .language-menu {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: 0.5rem;
    background-color: rgba(30, 41, 59, 0.95);
    border-radius: 0.5rem;
    padding: 0.5rem;
    min-width: 8rem;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .language-menu.show {
    display: flex;
  }
  
  .language-option {
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: rgba(209, 213, 219);
    border-radius: 0.25rem;
    transition: all 0.2s ease;
    text-align: left;
    font-size: 0.93rem;
  }
  
  .language-option:hover {
    background-color: rgba(55, 65, 81, 0.7);
    color: white;
  }
  
  .language-option.active {
    background-color: rgba(37, 99, 235, 0.8);
    color: white;
    font-weight: 500;
  }
  
  @media (max-width: 768px) {
    .language-switcher {
      bottom: 1rem;
      left: 1rem;
    }
    
    .language-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script>
  // Función para inicializar el Language Switcher
  function initLanguageSwitcher(): void {
    const languageToggle = document.getElementById('language-toggle');
    const languageMenu = document.getElementById('language-menu');
    const languageDropdown = document.getElementById('language-dropdown');
    
    if (!languageToggle || !languageMenu || !languageDropdown) {
      return;
    }

    // Crear referencias locales para evitar errores de null
    const toggle = languageToggle;
    const menu = languageMenu;
    const dropdown = languageDropdown;

    let isMenuOpen = false;
    
    // Función para abrir/cerrar el menú de idiomas
    function toggleLanguageMenu(event: Event): void {
      event.stopPropagation();
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        menu.classList.add('show');
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.remove('show');
        toggle.setAttribute('aria-expanded', 'false');
      }
    }
    
    // Cerrar el menú si se hace clic fuera
    function closeLanguageMenu(event: Event): void {
      const target = event.target as Node;

      if (!dropdown.contains(target)) {
        menu.classList.remove('show');
        toggle.setAttribute('aria-expanded', 'false');
        isMenuOpen = false;
      }
    }
    
    // Limpiar event listeners previos clonando elementos
    const newToggle = toggle.cloneNode(true) as HTMLElement;
    toggle.parentNode?.replaceChild(newToggle, toggle);
    
    // Agregar listeners al nuevo botón
    newToggle.addEventListener('click', toggleLanguageMenu);
    
    // Listener global para cerrar
    document.addEventListener('click', closeLanguageMenu);
    
    // Si se presiona ESC, cerrar el menú
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isMenuOpen) {
        menu.classList.remove('show');
        newToggle.setAttribute('aria-expanded', 'false');
        isMenuOpen = false;
      }
    });
    
    // Los enlaces de idioma funcionan con navegación normal de Astro View Transitions
    // No necesitan preventDefault - dejar que las transiciones manejen la navegación
  }

  // Inicializar en carga inicial
  initLanguageSwitcher();
  
  // Re-inicializar después de View Transitions
  document.addEventListener('astro:page-load', initLanguageSwitcher);
</script>
