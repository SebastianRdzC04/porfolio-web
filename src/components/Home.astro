---
import SocialLinks from "./compose/SocialLinks.astro"
import { type Language, DEFAULT_LANGUAGE } from '../utils/i18n';

interface Props {
  lang?: Language;
}

const { lang = DEFAULT_LANGUAGE } = Astro.props;

const homeContent = {
  es: {
    greeting: "Hola, soy Sebastian Rodriguez",
    role: "Desarrollador Full Stack"
  },
  en: {
    greeting: "Hello, I'm Sebastian Rodriguez", 
    role: "Full Stack Developer"
  }
};
---

<div class="w-screen h-screen bg-center bg-black" style="background-image: url('/fondo.webp');">
  <div class="md:w-[70%] w-[92%] mx-auto h-full flex flex-col justify-center items-center text-white">
    <div class="text-center">
      <div data-reveal="zoom" style="--reveal-delay: 80ms;">
        <div class="relative w-fit mx-auto mb-8 parallax-soft motion-float" data-parallax data-parallax-speed="0.1">
          <div class="absolute inset-0 rounded-full bg-[#1F2E4A] p-[3px]" style="transform: scale(1.05);"></div>
          <img src="/nuevo-inicio.jpeg" alt="Foto de Sebastian Rodriguez" class="w-40 h-40 md:w-50 md:h-50 rounded-full object-cover relative z-10 border-2 border-[#F5F5F5]/40" />
          <div class="absolute top-0 right-0 w-3 h-3 bg-[#F7DC6F] rounded-full blur-sm animate-ping" style="animation-duration: 3s;"></div>
          <div class="absolute bottom-2 left-0 w-2 h-2 bg-[#E67E22] rounded-full blur-sm animate-ping" style="animation-duration: 4s;"></div>
        </div>
      </div>
      <div class="p-5 sm:p-6 bg-black/50 rounded-2xl" data-reveal="up-strong" style="--reveal-delay: 180ms;">
        <h1 class="text-[clamp(2rem,5vw,3.6rem)] leading-[1.05] font-bold mb-4 text-[#F5F5F5] drop-shadow-lg max-w-[20ch]">
          {homeContent[lang].greeting}
        </h1>
        <p class="text-[clamp(1.05rem,2.1vw,1.5rem)] leading-snug text-center sm:text-end font-semibold tracking-wide">
          {homeContent[lang].role}
        </p>
      </div>
      <div class="flex pt-5 mx-auto w-full justify-center" data-reveal style="--reveal-delay: 300ms;">
        <SocialLinks />
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>
