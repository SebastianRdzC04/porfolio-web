---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { type Language, DEFAULT_LANGUAGE } from '../../utils/i18n';
import { useTranslations } from '../../utils/translations';

interface Props {
  clientPath: string;
  client: CollectionEntry<'clients'> | undefined;
  document: CollectionEntry<'clientDocs'> | undefined;
  lang?: Language;
}

const { clientPath, client, document, lang = DEFAULT_LANGUAGE } = Astro.props;
const t = useTranslations(lang);

const rendered = document ? await render(document) : null;
---

<section class="pt-40 pb-16 px-4 md:px-0">
  <a href={lang === 'es' ? `/clients/${clientPath}` : `/en/clients/${clientPath}`} class="inline-flex items-center gap-2 text-indigo-300 hover:text-indigo-200 transition-colors text-sm font-medium" data-reveal>
    <span>←</span>
    <span>{t('clients.back')}</span>
  </a>

  {client && document && rendered ? (
    <article class="mt-10 max-w-4xl mx-auto">
      <div class="text-center">
        <p class="text-xs uppercase tracking-[0.34em] text-indigo-300/80">{document.data.docType ?? 'MD'}</p>
        <h1 class="mt-3 text-[clamp(2rem,4vw,3rem)] font-bold leading-tight text-indigo-100">{document.data.title}</h1>
        {document.data.description && <p class="mt-4 text-[1rem] md:text-[1.06rem] leading-relaxed text-gray-300 max-w-3xl mx-auto">{document.data.description}</p>}
        <p class="mt-4 text-xs uppercase tracking-[0.28em] text-gray-500">{client.data.title}</p>
      </div>

      <div class="mt-10 document-content prose prose-invert md:prose-lg text-white max-w-none text-[clamp(1rem,1.15vw,1.06rem)] prose-p:leading-relaxed prose-li:leading-relaxed prose-headings:tracking-tight prose-headings:leading-tight prose-a:text-indigo-300 prose-strong:text-indigo-100">
        <rendered.Content />
      </div>
    </article>
  ) : (
    <div class="mt-10 rounded-3xl border border-indigo-500/20 bg-indigo-500/5 p-6 text-indigo-100">
      <h1 class="text-xl font-semibold mb-2">{lang === 'es' ? 'Contenido pendiente' : 'Content pending'}</h1>
      <p class="text-sm text-gray-300">{t('clients.pending')}</p>
    </div>
  )}
</section>

<style>
  .document-content {
    color: #e5e7eb;
  }

  .document-content :global(hr) {
    border-color: rgba(255, 255, 255, 0.12);
  }
</style>
