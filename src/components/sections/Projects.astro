---
import ProjectCard from '../compose/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getContentByLanguage, type Language, DEFAULT_LANGUAGE } from '../../utils/i18n';
import { useTranslations } from '../../utils/translations';

interface Props {
  lang?: Language;
}

const { lang = DEFAULT_LANGUAGE } = Astro.props;
const allProjects = await getCollection("projects");
const projects = getContentByLanguage(allProjects, lang);
const allPersonalProjects = await getCollection("personalProjects");
const personalProjects = getContentByLanguage(allPersonalProjects, lang);
const t = useTranslations(lang);
---

<section id="projects" class="py-14 px-4">
    <h3 class="text-[clamp(1.8rem,3.2vw,2.35rem)] leading-tight font-bold mb-8 text-center text-indigo-400">{t('projects.title')}</h3>
    
    <div class="projects-container overflow-x-auto pb-4">
        <div class="flex gap-6 min-w-max">
            {
                projects.map(project => {
                    const { data } = project;
                    const {title, description, technologies, imageUrl, path} = data;
                    // Generar la ruta correcta según el idioma
                    const projectPath = lang === 'es' ? `/projects/${path}` : `/en/projects/${path}`;
                    return (
                        <ProjectCard 
                            title={title} 
                            description={description} 
                            technologies={technologies} 
                            imageUrl={imageUrl} 
                            path={projectPath}
                            lang={lang}
                        />
                    )
                })
            }
        </div>
    </div>

    <h4 class="text-[clamp(1.45rem,2.4vw,1.9rem)] leading-tight font-bold mt-12 mb-6 text-center text-indigo-300">{t('projects.personalTitle')}</h4>

    <div class="projects-container overflow-x-auto pb-4">
        <div class="flex gap-6 min-w-max">
            {
                personalProjects.map(project => {
                    const { data } = project;
                    const { title, description, technologies, imageUrl, path } = data;
                    const projectPath = lang === 'es' ? `/projects/${path}` : `/en/projects/${path}`;

                    return (
                        <ProjectCard
                            title={title}
                            description={description}
                            technologies={technologies}
                            imageUrl={imageUrl}
                            path={projectPath}
                            lang={lang}
                        />
                    )
                })
            }
        </div>
    </div>
</section>

<style>
    .projects-container {
        max-height: calc(100vh - 200px);
        scrollbar-width: thin;
    }
    
    .projects-container::-webkit-scrollbar {
        height: 6px;
    }
    
    .projects-container::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }
</style>
