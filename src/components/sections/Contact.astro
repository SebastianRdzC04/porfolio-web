---
import { type Language, DEFAULT_LANGUAGE } from '../../utils/i18n';
import { useTranslations } from '../../utils/translations';

interface Props {
  lang?: Language;
}

const { lang = DEFAULT_LANGUAGE } = Astro.props;
const t = useTranslations(lang);

// Contact information
const whatsappNumber = '+528719960531';
const email = 'sebastianrdzc04@gmail.com';
const whatsappNumberDisplay = whatsappNumber.replace('+52', '+52 ').replace(/(\d{3})(\d{3})(\d{4})/, '$1 $2 $3');
---

<section class="py-14 px-4 md:px-6 text-gray-100 w-full" id="contact">
    <h3 class="text-[clamp(1.8rem,3.2vw,2.35rem)] leading-tight font-bold text-indigo-400 pb-5 text-center">{t('contact.title')}</h3>
    
    <div class="flex flex-col">
        <p class="text-center text-[clamp(1rem,1.7vw,1.14rem)] leading-relaxed mb-8">
            {t('contact.intro')}
        </p>
        
        <div class="flex flex-col md:flex-row gap-12 justify-between">
            <!-- WhatsApp Card -->
            <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" 
               class="bg-gray-800/30 rounded-lg p-6 flex flex-col items-center transition-transform transform hover:scale-105 hover:bg-gray-800/50 w-full md:w-1/2">
                <div class="w-16 h-16 flex items-center justify-center text-green-500 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="74" height="74" viewBox="0 0 24 24"><path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01m-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18l-3.12.82l.83-3.04l-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81c-.23-.08-.39-.12-.56.12c-.17.25-.64.81-.78.97c-.14.17-.29.19-.54.06c-.25-.12-1.05-.39-1.99-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.14-.25-.02-.38.11-.51c.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74c.59.26 1.05.41 1.41.52c.59.19 1.13.16 1.56.1c.48-.07 1.47-.6 1.67-1.18c.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28"/></svg>
                </div>
                <h4 class="text-[1.25rem] md:text-[1.32rem] font-semibold text-indigo-300 mb-2">{t('contact.whatsapp')}</h4>
                <p class="text-gray-300 text-center text-[0.98rem] leading-relaxed">{t('contact.whatsappDesc')}</p>
                <span class="mt-4 px-4 py-2 bg-green-600/20 text-green-400 rounded-full text-[0.9rem] font-semibold">{whatsappNumberDisplay}</span>
            </a>
            
            <!-- Email Card -->
            <a href={`mailto:${email}`} target="_blank" rel="noopener noreferrer" 
               class="bg-gray-800/30 rounded-lg p-6 flex flex-col items-center transition-transform transform hover:scale-105 hover:bg-gray-800/50 w-full md:w-1/2">
                <div class="w-16 h-16 flex items-center justify-center text-blue-500 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="74" height="74" viewBox="0 0 24 24"><path fill="currentColor" d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2zm-2 0l-8 5l-8-5zm0 12H4V8l8 5l8-5z"/></svg>
                </div>
                <h4 class="text-[1.25rem] md:text-[1.32rem] font-semibold text-indigo-300 mb-2">{t('contact.email')}</h4>
                <p class="text-gray-300 text-center text-[0.98rem] leading-relaxed">{t('contact.emailDesc')}</p>
                <span class="mt-4 px-4 py-2 bg-blue-600/20 text-blue-400 rounded-full text-[0.9rem] font-semibold">{email}</span>
            </a>
        </div>
        
        <div class="mt-10 text-center">
            <p class="text-indigo-200 text-[0.98rem] font-medium">{t('contact.response')}</p>
        </div>
    </div>
</section>
