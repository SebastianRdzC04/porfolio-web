---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { fade } from "astro:transitions";
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { type Language, getContentTranslations, DEFAULT_LANGUAGE } from '../../utils/i18n';
import { useTranslations } from '../../utils/translations';

export const getStaticPaths = (async () => {
    const projects = await getCollection("projects");
    const personalProjects = await getCollection("personalProjects");
    const allProjects = [...projects, ...personalProjects];
    
    // Filtrar solo proyectos en español para esta ruta
    const spanishProjects = allProjects.filter(project => 
        (project.data.lang || DEFAULT_LANGUAGE) === DEFAULT_LANGUAGE
    );

    // Generar rutas solo para proyectos en español
    return spanishProjects.map(project => ({
        params: { id: project.data.path },
        props: { 
            project,
            lang: DEFAULT_LANGUAGE as Language,
            allProjects
        }
    }));
}) satisfies GetStaticPaths;

type ProjectEntry = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
type PersonalProjectEntry = Awaited<ReturnType<typeof getCollection<'personalProjects'>>>[number];
type ProjectContentEntry = ProjectEntry | PersonalProjectEntry;

interface Props {
    project: ProjectContentEntry;
    lang: Language;
    allProjects: ProjectContentEntry[];
}

const { project, lang, allProjects } = Astro.props;
const { title, description } = project.data;
const t = useTranslations(lang);

const { Content } = await render(project);

// Obtener traducciones del proyecto actual
const translations = getContentTranslations(allProjects, project.id);

// Generar URL canónica
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTransition = fade({ duration: '0.28s' });
---

<Layout title={title} description={description} lang={lang} pageUrl={canonicalUrl}>
    <LanguageSwitcher 
        currentLang={lang}
        currentPath={Astro.url.pathname}
        translations={translations}
    />
    <div class="mt-20 flex justify-center" transition:animate={pageTransition}>
        <div class="prose prose-invert md:prose-lg text-white mb-16 px-4 text-[clamp(1rem,1.3vw,1.08rem)] prose-p:leading-relaxed prose-li:leading-relaxed prose-headings:tracking-tight prose-headings:leading-tight prose-a:text-indigo-300 prose-strong:text-indigo-100">
            <Content />
        </div>
    </div>
</Layout>
